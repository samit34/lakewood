# Copy this file to .env.local (local dev) and fill in the values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# NEVER commit .env.local. Only NEXT_PUBLIC_* values are visible in the browser.

# ---------------------------------------------------------------- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- Database (MongoDB Atlas)
# Atlas → Database → Connect → Drivers. Keep "/lakewood" as the database name.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/lakewood?retryWrites=true&w=majority

# ---------------------------------------------------------------- Razorpay (use rzp_test_ keys first)
# Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add New Webhook
#   URL:    https://YOUR-DOMAIN/api/razorpay/webhook
#   Events: payment.captured, order.paid, payment.failed
#   Secret: any long random text you choose – paste the same value here
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Zoom (Server-to-Server OAuth app)
# marketplace.zoom.us → Develop → Build App → Server-to-Server OAuth → App Credentials
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Email of the licensed Zoom user who hosts the batch meetings (meetings are created per batch from /admin)
ZOOM_HOST_EMAIL=
# Register students on Zoom this many hours before their batch starts
ZOOM_REGISTER_HOURS_BEFORE_START=24

# ---------------------------------------------------------------- Email (Resend)
# resend.com → API Keys. EMAIL_FROM must use a domain verified in Resend
# (for testing you can use onboarding@resend.dev, which only delivers to your own email).
RESEND_API_KEY=
EMAIL_FROM=Lakewood IELTS Institute <onboarding@resend.dev>
ADMIN_EMAIL=lakewoodieltsinstitute@gmail.com

# ---------------------------------------------------------------- Admin & cron
# Admin accounts live in the database; create the first one with: npm run create-admin
# 32-byte random key (base64) used to encrypt two-factor (TOTP) secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_ENCRYPTION_KEY=
# Sent as "Authorization: Bearer <CRON_SECRET>" to /api/cron/cleanup (every 15 min). Long random value.
CRON_SECRET=

# ---------------------------------------------------------------- Optional
# Cloudflare Turnstile spam check (set TURNSTILE_ENABLED=true to switch on)
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Analytics (leave blank to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# WhatsApp notifications (future provider; leave false)
WHATSAPP_ENABLED=false
